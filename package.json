{
  "name": "finewirejs",
  "version": "0.1.0",
  "description": "Fine-grained signals woven into the DOM — the template runs once, updates patch single nodes.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.1.5"
  },
  "license": "MIT",
  "author": "KiranMantha",
  "keywords": [
    "signals",
    "reactive",
    "fine-grained",
    "template-literals",
    "ui",
    "framework",
    "no-vdom",
    "dom"
  ]
}